Bootstrap: docker
From: eclipse-temurin:17-jdk-jammy@sha256:73ed442231ec66cfe48cae0b263ce619a75ab96d162ab325f38fc0a269ee3aab

%labels
    org.opencontainers.image.title BeastXPy
    org.opencontainers.image.version 0.1.0
    org.opencontainers.image.licenses MIT AND LGPL-2.1-only

%files
    pyproject.toml /opt/beastxpy/pyproject.toml
    README.md /opt/beastxpy/README.md
    LICENSE /opt/beastxpy/LICENSE
    NOTICE /opt/beastxpy/NOTICE
    beastxpy /opt/beastxpy/beastxpy
    examples /opt/beastxpy/examples
    tools /opt/beastxpy/tools
    deploy/beagle /tmp/beagle-src

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev build-essential cmake curl ca-certificates
    rm -rf /var/lib/apt/lists/*

    # Native BEAGLE. Use a local tarball when one was dropped into
    # deploy/beagle/, otherwise download the pinned official release.  Both
    # paths must match the pinned SHA-256; a mismatch aborts the build.
    mkdir -p /tmp/beagle
    if [ -f /tmp/beagle-src/beagle-lib.tar.gz ]; then
        cp /tmp/beagle-src/beagle-lib.tar.gz /tmp/beagle.tar.gz
    else
        curl -fsSL https://codeload.github.com/beagle-dev/beagle-lib/tar.gz/refs/tags/v4.0.1 \
            -o /tmp/beagle.tar.gz
    fi
    echo "9d258cd9bedd86d7c28b91587acd1132f4e01d4f095c657ad4dc93bd83d4f120  /tmp/beagle.tar.gz" \
        | sha256sum -c -
    tar -xzf /tmp/beagle.tar.gz -C /tmp/beagle --strip-components=1
    cd /tmp/beagle
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_CUDA=OFF
    cmake --build build --parallel "$(nproc)"
    cmake --install build
    ldconfig
    rm -rf /tmp/beagle /tmp/beagle-src /tmp/beagle.tar.gz
    test -e /usr/local/lib/libhmsbeagle.so

    # BeastXPy itself. The BEAST jars are committed under
    # beastxpy/tools/jars/, so Gate 3 works without network access.
    cd /opt/beastxpy
    python3 -m pip install --upgrade pip
    python3 -m pip install .

    # Unprivileged runtime user.
    groupadd --gid 10001 beastxpy
    useradd --uid 10001 --gid beastxpy --create-home --shell /usr/sbin/nologin beastxpy
    mkdir -p /work
    chown -R beastxpy:beastxpy /work /opt/beastxpy

%environment
    export JAVA_HOME=/opt/java/openjdk
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONUNBUFFERED=1
    export BEASTX_BEAGLE_10_5_0_LIB=/usr/local/lib

%runscript
    exec beastxpy "$@"

%startscript
    exec beastxpy "$@"

%help
    BeastXPy 0.1.0 - reproducible BEAST 1 divergence-time estimation.

    The image contains Python, a JDK 17, the BEAST 1.10.4 and BEAST X 10.5.0
    jars that ship with the repository, and native BEAGLE 4.0.1 for BEAST X
    10.5.0. It runs as the unprivileged user `beastxpy` and its entrypoint is
    `beastxpy`.

    Example:
        apptainer run beastxpy_0.1.0.sif --help
        apptainer exec --bind "$PWD:/work" beastxpy_0.1.0.sif \
            beastxpy generate --config /work/config.yaml --help

    BEAGLE 3.1.0 (the ABI BEAST 1.10.4 needs) is not bundled; bind-mount it and
    set BEASTX_BEAGLE_1_10_4_LIB if you need native likelihoods on 1.10.4.
